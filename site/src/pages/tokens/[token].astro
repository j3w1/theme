---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SourceLink from "../../components/SourceLink.astro";
import { usageIndex, tokenUrl } from "../../lib/usage";
import { withBase } from "../../lib/base";
import { anchorFor } from "../../../../scripts/lib/anchors.mjs";
import "../../styles/components/description-list.css";

export function getStaticPaths() {
  return Object.keys(usageIndex.profiles.default.tokens).map((token) => ({ params: { token } }));
}

const path = Astro.params.token!;
const primary = usageIndex.profiles.default.tokens[path];
---
<SiteLayout title={path} description={primary.description ?? "Documented token values and dependencies."} revision>
  <div class="site-actions">
    <a class="link link-standalone" href={withBase(`tokens/?query=${encodeURIComponent(path)}`)}>Find related usage</a>
    <a class="link link-standalone" href={`${withBase("reference/")}#${anchorFor.token(path)}`}>Specification anchor</a>
    <a class="link link-standalone" href={`${withBase("reference/")}#contrast-report`}>Measured contrast report (default profile)</a>
    <a class="link link-standalone" href={withBase(`report/?token=${encodeURIComponent(path)}`)}>Report an issue with this token</a>
  </div>
  <div class="site-actions js-only">
    <code>{path}</code>
    <button class="button button-secondary" type="button" data-copy={path} aria-label={`Copy token path ${path}`}>Copy path</button>
    <code>{primary.variable}</code>
    <button class="button button-secondary" type="button" data-copy={primary.variable} aria-label={`Copy CSS variable ${path}`}>Copy variable</button>
  </div>
  <nav class="site-actions" aria-label="Profile details">
    {Object.keys(usageIndex.profiles).map((profile) => <a class="link link-standalone" href={`#${anchorFor.tokenProfile(path, profile)}`}>{profile}</a>)}
  </nav>
  {Object.entries(usageIndex.profiles).map(([profile, data]) => {
    const token = data.tokens[path];
    return <section class="site-section usage-section" id={anchorFor.tokenProfile(path, profile)}>
      <h2>{profile} · {data.status}</h2>
      <dl class="description-list">
        <div><dt>Resolved value</dt><dd><code>{token.css}</code></dd></div>
        <div><dt>Status</dt><dd>{token.status}{token.deprecated && ` · deprecated: ${token.deprecated}`}</dd></div>
        <div><dt>Consumption</dt><dd>{token.eligibility.action} — {token.eligibility.reason}</dd></div>
        <div><dt>Decisions</dt><dd>{token.eligibility.decisionIds.length ? token.eligibility.decisionIds.map((id) => <a class="link" href={`${withBase("reference/")}#${anchorFor.decision(id)}`}>{id} </a>) : "None pending."}</dd></div>
        <div><dt>Source</dt><dd><SourceLink source={token.source} /></dd></div>
        <div><dt>Alias chain</dt><dd>{token.aliases.length ? token.aliases.map((alias) => <><a class="link" href={tokenUrl(alias)}><code>{alias}</code></a> </>) : "Literal value; no alias dependencies."}</dd></div>
        <div><dt>Used by aliases</dt><dd>{token.usedByAliases.length ? token.usedByAliases.map((alias) => <><a class="link" href={tokenUrl(alias)}><code>{alias}</code></a> </>) : "No declared aliases depend on this role."}</dd></div>
      </dl>
      <h3>Provenance and restrictions</h3>
      <pre class="site-code"><code>{JSON.stringify(token.provenance, null, 2)}</code></pre>
      <h3>Declared component and port usage</h3>
      {token.uses.length ? <div class="site-table-wrap" tabindex="0" role="region" aria-label={`${profile} declared usage`}>
        <table class="table">
          <thead><tr><th class="table-header" scope="col">Consumer / kind</th><th class="table-header" scope="col">Part / variant</th><th class="table-header" scope="col">State / surface</th><th class="table-header" scope="col">Source declaration</th></tr></thead>
          <tbody class="table-body">
            {token.uses.map((use) => <tr class="table-row">
              <td class="table-cell">{use.component ? <a class="link" href={`${withBase("reference/")}#${anchorFor.component(use.component)}`}>{use.component}</a> : use.port ?? "Shared rule"} · {use.kind}{use.nativeKey && <code>{use.nativeKey}</code>}</td>
              <td class="table-cell">{use.part ?? "—"}{use.variant && ` · ${use.variant}`}</td>
              <td class="table-cell">{use.state ?? "—"}{use.surface && <> · <a class="link" href={tokenUrl(use.surface)}>{use.surface}</a></>}</td>
              <td class="table-cell"><SourceLink source={use.source} /></td>
            </tr>)}
          </tbody>
        </table>
      </div> : <p>No declared component or port mapping. Unindexed consumers are unknown.</p>}
      {token.unmappedPorts.length > 0 && <>
        <h3>Declared unmapped ports</h3>
        <ul>{token.unmappedPorts.map((port) => <li>{port.port}: {port.reason} · <SourceLink source={port.source} /></li>)}</ul>
      </>}
      <h3>Relevant contrast declarations</h3>
      {token.contrast.length
        ? <ul>{token.contrast.map((pair) => <li>{pair.label ?? "Declared pair"}: <a class="link" href={tokenUrl(pair.fg)}>{pair.fg}</a> on <a class="link" href={tokenUrl(pair.bg)}>{pair.bg}</a> · <SourceLink source={pair.source} /></li>)}</ul>
        : <p>No contrast pair is declared for this role.</p>}
    </section>;
  })}
</SiteLayout>
