---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Guide from "../../../../docs/ui-consumption.md";
import { withBase } from "../../lib/base";
import { theme } from "../../lib/theme";
import { consumerExamples } from "../../../../scripts/lib/ui-consumer-examples.mjs";

const files = await consumerExamples();
const frameworkFiles = ["html/index.html", "html/main.js", "vue/App.vue", "vue/main.js", "vite.config.js", "react/main.js", "astro/src/pages/index.astro", "astro.config.mjs"];
---
<SiteLayout title="Implement the theme" description="Install exact artifacts, preserve native semantics and bring j3w1 components into Vue, React, Astro or plain HTML.">
  <div class="site-actions">
    <a class="link link-standalone" href={withBase(`downloads/j3w1-ui-${theme.version}.tgz`)}>Download the package tarball</a>
    <a class="link link-standalone" href={withBase("downloads/release.json")}>Artifact digest and publication status</a>
  </div>
  <div class="site-prose"><Guide /></div>
  <section class="site-section">
    <h2>Maintained framework examples</h2>
    <p>These exact source files are compiled and exercised against the packed artifact in isolated HTML, Vue, React and Astro fixtures. They demonstrate native submission, validation, reset and disabled fieldsets. Use the component pages for the native markup and API of other controls.</p>
    {frameworkFiles.map((file) => <section>
      <h3>{file}</h3>
      <div class="site-actions">
        <a class="link link-standalone" href={withBase(`ui/frameworks/${file}`)}>Download source</a>
        <button class="button button-secondary" data-copy={files.get(file)} type="button">Copy source</button>
      </div>
      <pre class="site-code"><code>{files.get(file)}</code></pre>
    </section>)}
  </section>
</SiteLayout>
