---
import ToolLayout from "../../layouts/ToolLayout.astro";
import IssueDraft from "../../components/IssueDraft.astro";
import { theme, coverageLedger, defaultTokens } from "../../lib/theme";
import { sha256 } from "../../../../scripts/lib/fs.mjs";
import { anchorFor } from "../../../../scripts/lib/anchors.mjs";
import { usageRevision } from "../../lib/revision";
import "../../styles/workbench.css";
const data = { themeVersion: theme.version, siteUrl: theme.site.url, revision: usageRevision, sourceDigest: sha256(JSON.stringify({ theme, coverageLedger, defaultTokens })), components: Object.keys(coverageLedger.components), tokens: Object.keys(defaultTokens), profiles: theme.profiles.map(p => p.id) };
---
<ToolLayout title="Report a specification issue" description="Prepare and review a public issue for a component or token.">
  <div class="workbench" data-report-page data-report-data={JSON.stringify(data)}>
    <p data-report-target role="status">Choose a component or token. Without JavaScript, use the direct GitHub link below and describe the target in the issue.</p>
    <form class="workbench-controls js-only" data-report-controls>
      <label for={anchorFor.workbench("report", "target")}>Component or token<select id={anchorFor.workbench("report", "target")} name="target"><option value="">Choose a target</option><optgroup label="Components">{data.components.map(id => <option value={`component:${id}`}>{id}</option>)}</optgroup><optgroup label="Tokens">{data.tokens.map(id => <option value={`token:${id}`}>{id}</option>)}</optgroup></select></label>
      <label for={anchorFor.workbench("report", "profile")}>Profile<select id={anchorFor.workbench("report", "profile")} name="profile">{theme.profiles.map(p => <option value={p.id}>{p.id} — {p.status}</option>)}</select></label>
    </form>
    <IssueDraft id="specification" />
  </div>
</ToolLayout>
<script>import "../../scripts/report";</script>
