---
import { buildCommit } from "../lib/revision";
/* Static specification hub. Legacy anchors link directly to the full detail. */
import { POLICY_TEXT, releaseOf } from "../../../scripts/lib/eligibility.mjs";
import { getCollection, render } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import TextField from "../components/fields/TextField.astro";
import SelectField from "../components/fields/SelectField.astro";
import Checkbox from "../components/fields/Checkbox.astro";
import "../styles/site.css";
import "../styles/print.css";
import Toc from "../components/Toc.astro";
import DocSection from "../components/DocSection.astro";
import FamilySection from "../components/FamilySection.astro";
import TokenTable from "../components/TokenTable.astro";
import FoundationSpecimens from "../components/FoundationSpecimens.astro";
import ContrastReport from "../components/ContrastReport.astro";


import SupportTable from "../components/SupportTable.astro";
import CoverageLedger from "../components/CoverageLedger.astro";
import { withBase } from "../lib/base";
import { anchors, familyList, profiles, referenceCatalogue, referenceSources, theme } from "../lib/theme";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const doc = (id: string) => docs.find((d) => d.data.id === id)!;
const components = (await getCollection("components")).sort((a, b) => a.data.order - b.data.order);
const ports = await getCollection("ports");
const agentDocs = await getCollection("agents");
const consume = agentDocs.find((a) => a.id === "consume");
const { Content: ConsumeContent } = consume ? await render(consume) : { Content: null };

const familiesWithComponents = familyList
  .filter((f) => f.id !== "foundations")
  .map((f) => ({ ...f, entries: components.filter((c) => c.data.family === f.id) }))
  .filter((f) => f.entries.length > 0);

const repositories = referenceSources.repositories as Record<string, { repo: string; revision: string }>;
const title = theme.displayName;
const description = "Identity, role tables, component index, accessibility and portability rules. Full state matrices, contrast pairs and decisions have dedicated static pages.";
const decisionEntry = doc("decisions");
const { headings: decisionHeadings } = await render(decisionEntry);
const tocDocs = [{ id: "identity", title: "Identity" }, { id: "foundations", title: "Foundations" }];
const fixtureAnchors = [anchors.specimen("stress"), anchors.specimen("non-examples"), ...["FX-LONG", "FX-320", "FX-I18N", "FX-RTL", "FX-RM", "FX-HC", "FX-TOUCH", "FX-DENSITY", "FX-OVERFLOW"].map(anchors.fixture), ...["pills", "glass", "gradients", "glow", "everything-red", "material", "light", "rainbow", "traffic-light", "sans", "inactive-text", "focus-as-selection", "heritage-ui", "circles", "hairline-edge", "opacity-disabled"].map(anchors.nonExample)];
const tocExtra = [
  { id: "stress-and-non-examples", title: "Stress fixtures and non-examples" },
  { id: anchors.doc("form-patterns"), title: "Form composition and recovery" },
  { id: anchors.doc("figma-bridge"), title: "Figma Variables bridge" },
  { id: anchors.doc("accessibility"), title: "Accessibility" },
  { id: anchors.doc("portability"), title: "Portability" },
  { id: "references", title: "References" },
  { id: "for-agents", title: "For agents" },
  { id: anchors.doc("decisions"), title: "Decisions" },
];
---

<SiteLayout title={title} description={description} revision>
  <header class="reference-header">
    <p class="banner" id="consumption-policy">{releaseOf(theme.version).stability}: <code>{theme.version}</code>. {POLICY_TEXT}</p>
    <div class="controls js-only" id="controls">
      <TextField id="search" type="search" label="Search components, documents and tokens" placeholder="e.g. focus ring, text-field" autocomplete="off" />
      <span class="live-count" id="search-count" aria-live="polite"></span>
      <fieldset id="family-filter">
        <legend>Families (all shown by default)</legend>
        {familyList.filter((f) => f.id !== "foundations").map((f) => (
          <Checkbox name="family" value={f.id} checked>{f.title}</Checkbox>
        ))}
      </fieldset>
      <SelectField id="density" label="Specimen density"><option value="compact">compact</option><option value="comfortable">comfortable</option></SelectField>
      <SelectField id="profile" label="Specimen profile">{Object.entries(profiles).map(([id, p]) => <option value={id}>{id} ({p.status})</option>)}</SelectField>
      <button type="button" class="button button-tertiary" id="reset">Reset page preferences</button>
    </div>
  </header>

  <div class="layout">
    <Toc docs={tocDocs} families={familiesWithComponents.map((f) => ({ id: f.id, title: f.title, components: f.entries.map((e) => ({ id: e.data.id, name: e.data.name })) }))} extra={tocExtra} />

    <div class="reference-content">
      <DocSection entry={doc("identity")} />

      <DocSection entry={doc("foundations")}>
        <div class="block" id={anchors.family("foundations")}>
          <h3>Tokens</h3>
          <p id="eligibility-legend">Eligibility: <strong>use</strong> within the role's scope; <strong>use-and-report</strong> records its pending decision; <strong>blocked</strong> excludes delivery; <strong>historical-only</strong> preserves heritage; <strong>preview-only</strong> excludes delivery. Approval and consumption eligibility stay separate.</p>
          <p><a class="link link-standalone" href={withBase("tokens/")}>All profile values, primitives and documented usage →</a></p>
          <TokenTable prefix="color.surface." title="Surfaces" grid />
          <TokenTable prefix="color.text." title="Text" grid />
          <FoundationSpecimens />
          <TokenTable prefix="color.border." title="Borders" />
          <TokenTable prefix="color.interaction." title="Interaction" />
          <TokenTable prefix="color.action." title="Actions" />
          <TokenTable prefix="color.status." title="Status" />
          <TokenTable prefix="color.code." title="Code" />
          <TokenTable prefix="color.diagnostic." title="Diagnostics" />
          <TokenTable prefix="color.diff." title="Diffs" />
          <TokenTable prefix="color.terminal." title="Terminal" />
          <TokenTable prefix="color.chart." title="Charts" />
          <TokenTable prefix="color.icon." title="Icons" />
          <TokenTable prefix="space." title="Spacing" />
          <TokenTable prefix="density." title="Density" />
          <TokenTable prefix="border." title="Border widths" />
          <TokenTable prefix="radius." title="Radius" />
          <TokenTable prefix="font." title="Typography" />
          <TokenTable prefix="focus." title="Focus" />
          <TokenTable prefix="motion." title="Motion" />
          <TokenTable prefix="shadow." title="Elevation" />
          <TokenTable prefix="layout." title="Layout" />
          <TokenTable prefix="breakpoint." title="Breakpoints" />
          <TokenTable prefix="icon." title="Icon sizes" />
          <TokenTable prefix="z." title="Stacking" />
          <TokenTable prefix="color.primitive." title="Primitives (inspection only; consume roles, not primitives)" />
        </div>
      </DocSection>

      {familiesWithComponents.map((f) => <FamilySection family={f} entries={f.entries} compact />)}
      {familiesWithComponents.length === 0 && (
        <section class="family" id="components-pending">
          <h2>Components</h2>
          <p class="family-description">Component specifications land family by family; the coverage ledger below records what is specified, demonstrated and test implemented.</p>
        </section>
      )}

      <section class="doc" id="stress-and-non-examples">
        <h2>Stress fixtures and non-examples</h2>
        <p><a class="link link-standalone" href={withBase("reference/fixtures/")}>Stress fixtures and labelled non-examples →</a></p>
        {fixtureAnchors.map((id) => <p><a class="link" id={id} data-legacy-target href={withBase(`reference/fixtures/#${id}`)}>{id}</a></p>)}
      </section>

      <DocSection entry={doc("form-patterns")} />
      <DocSection entry={doc("figma-bridge")} />
      <DocSection entry={doc("accessibility")}>
        <ContrastReport summary />
      </DocSection>

      <DocSection entry={doc("portability")}>
        <SupportTable ports={ports} />
        <CoverageLedger />
      </DocSection>

      <section class="doc prose" id="references">
        <h2>References</h2>
        <p class="family-description">Where the values came from and what each reference does not prove. Nothing here is a supported download.</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table">
          <table>
            <thead><tr><th scope="col">Reference</th><th scope="col">Kind</th><th scope="col">Where</th><th scope="col">What it does not prove</th></tr></thead>
            <tbody>
              {(referenceCatalogue.entries as any[]).map((e) => (
                <tr>
                  <td>{e.title}</td>
                  <td>{e.kind}</td>
                  <td>{e.source ? <><code>{repositories[e.source.repository].repo}</code>@<code>{repositories[e.source.repository].revision.slice(0, 7)}</code> <code>{e.source.path}</code></> : <code>{e.path}</code>}</td>
                  <td>{e.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="doc prose" id="for-agents">
        <h2>For agents</h2>
        <p class="family-description">Do not read this page. Pin a tag or commit and fetch the exports at that revision; the site is confirmation only.</p>
        <ul class="export-links">
          <li><a href={withBase("agents/consume.md")}>agents/consume.md</a> — the reading protocol, prohibitions, report and lock formats</li>
          <li><a href={withBase("theme.json")}>theme.json</a> — manifest: profiles, entry points, export map</li>
          <li><a href={withBase("exports/theme.compact.md")}>exports/theme.compact.md</a> — the smallest complete statement of the contract</li>
          <li><a href={withBase("exports/tokens.resolved.json")}>exports/tokens.resolved.json</a> — every profile, every alias resolved</li>
          <li><a href={withBase("exports/tokens.css")}>exports/tokens.css</a> — roles as CSS custom properties</li>
          <li><a href={withBase("exports/theme.full.md")}>exports/theme.full.md</a> — everything in one document</li>
          <li><a href={withBase("exports/contrast.md")}>exports/contrast.md</a> — every declared pair, unrounded</li>
          <li><a href={withBase("exports/coverage.json")}>exports/coverage.json</a> — specified / demonstrated / test implemented</li>
          <li><a href={withBase("exports/digests.json")}>exports/digests.json</a> — sha256 per export for theme.lock.json</li>
          <li><a href={withBase("llms.txt")}>llms.txt</a> — discovery index</li>
        </ul>
        {ConsumeContent && <div class="spec-body"><ConsumeContent /></div>}
      </section>

      <section class="doc prose" id={anchors.doc("decisions")} data-doc="decisions">
        <h2>Decisions</h2>
        <p><a class="link link-standalone" href={withBase("reference/decisions/")}>Read the decision log →</a></p>
        <ul class="decision-index">{decisionHeadings.map((heading) => <li><a class="link" id={heading.slug} data-legacy-target href={withBase(`reference/decisions/#${heading.slug}`)}>{heading.text}</a></li>)}</ul>
      </section>
    </div>
  </div>

  <script>import "../scripts/main"; import "../scripts/legacy-hash";</script>
</SiteLayout>
