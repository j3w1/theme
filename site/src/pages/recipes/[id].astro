---
import SiteLayout from "../../layouts/SiteLayout.astro";
import TextField from "../../components/fields/TextField.astro";
import { withBase } from "../../lib/base";
import { blobUrl } from "../../lib/revision";
import { anchorFor } from "../../../../scripts/lib/anchors.mjs";
import index from "../../../../exports/recipes/index.json";

export function getStaticPaths() {
  return index.recipes.map((recipe) => ({ params: { id: recipe.id } }));
}

const id = Astro.params.id!;
const root = `exports/recipes/${id}/`;
const files = import.meta.glob("../../../../exports/recipes/**/*", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const read = (name: string) => files[`../../../../${root}${name}`];
const metadata = JSON.parse(read("manifest.json"));
const sources = ["markup.html", "tokens.css", "foundation.css", "component.css"].map((name) => ({ name, text: read(name) }));
const template = read("template.html");
---
<SiteLayout title={`${id} recipe`} description="A standalone reference generated from the canonical default specimen." revision>
  <div class="site-actions">
    <a class="link link-standalone" href={withBase("recipes/")}>All recipes</a>
    <a class="link link-standalone" href={`${withBase("reference/")}#${anchorFor.component(id)}`}>Component specification</a>
  </div>
  <section class="site-section">
    <h2>Behavior and limitations</h2>
    <ul>{metadata.limitations.map((text: string) => <li>{text}</li>)}</ul>
    <p>Supported visual states: {metadata.states.join(", ")}. No behavior module is supplied.</p>
    <div class="site-actions">
      <a class="link link-standalone" href={withBase(`${root}example.html`)}>Open standalone example</a>
      <a class="link link-standalone" href={withBase(`${root}example.html`)} download>Download standalone HTML</a>
      <a class="link link-standalone" href={withBase(`${root}two-instances.html`)}>Two independent instances</a>
    </div>
    <div class="site-actions">
      <a class="link link-standalone" href={withBase(`${root}manifest.json`)} download>Dependency manifest and digests</a>
      <a class="link link-standalone" href={withBase(`${root}README.md`)} download>Integration instructions</a>
      <a class="link link-standalone" href={withBase(`${root}LICENSE.md`)} download>Licenses</a>
    </div>
    <p>Markup: CC BY 4.0, adapted from j3w1 UI Theme Spec. CSS: MIT. Preserve the notices. Fonts are referenced by name and are not bundled.</p>
  </section>
  <section class="site-section">
    <h2>Copy an instance</h2>
    <p>Load token CSS, foundation CSS and component CSS in that order. Use a different instance prefix for every copy; all IDs, labels and ARIA references change together. Keep the wrapper and its density attribute. Styles are scoped to the wrapper; rem lengths preserve the specification’s 13px base without changing the host root.</p>
    <form class="site-filters js-only" data-recipe-copy>
      <TextField id={anchorFor.recipeSource("prefix")} label="Unique instance prefix" name="prefix" value={`${id}-one`} required pattern="[a-z][a-z0-9-]{0,63}" maxlength="64" />
      <button class="button" type="submit">Copy instance markup</button>
      <p role="status" data-recipe-status></p>
    </form>
  </section>
  <script type="application/json" id={anchorFor.recipeSource("template")} set:html={JSON.stringify({ template }).replaceAll("<", "\\u003c")} />
  {sources.map(({ name, text }) => <section class="site-section" id={anchorFor.recipeSource(name)}>
    <h2>{name}</h2>
    <div class="site-actions">
      <a class="link link-standalone" href={withBase(root + name)} download>Download {name}</a>
      <button class="button button-secondary js-only" type="button" data-copy={text}>Copy {name}</button>
    </div>
    <pre class="site-code" tabindex="0" role="region" aria-label={`${name} source, scrollable`}><code>{text}</code></pre>
  </section>)}
  <section class="site-section">
    <h2>Source identity</h2>
    <p>Version {metadata.version}; profile {metadata.profile}; source digest <code>{metadata.source.digest}</code>. Pin the supplying commit when consuming these files. A version number alone does not identify this artifact.</p>
    <ul>{Object.keys(metadata.source.files).map((file) => <li>{blobUrl(file) ? <a class="link" href={blobUrl(file)}>{file}</a> : <code>{file}</code>}</li>)}</ul>
  </section>
  <script>import "../../scripts/recipe-copy";</script>
</SiteLayout>
