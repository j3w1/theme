---
import PortalLayout from "../../layouts/PortalLayout.astro";
import { withBase } from "../../lib/base";
const tools = [["tokens/", "Token explorer", "Inspect values, uses, provenance and eligibility."], ["workbench/", "State workbench", "Compare canonical variants and states."], ["builder/", "Form builder", "Compose and export the bounded five-kind form model."], ["kit/", "Mapping task kit", "Prepare canonical inputs for an incompatible or native host."], ["figma/", "Figma Variables bridge", "Generate portable variable collections."], ["verification/", "Execution evidence", "Inspect revision-aware automated results and explicit limits."]];
---
<PortalLayout title="Tools" description="Inspect the specification, prepare application inputs and verify what has actually been exercised."><div class="portal-grid">{tools.map(([path, title, description]) => <a class="portal-card" href={withBase(path)}><h2>{title} →</h2><p>{description}</p></a>)}</div></PortalLayout>
