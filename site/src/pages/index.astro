---
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../lib/base";
import { cssVar, defaultTokens, theme } from "../lib/theme";
import inventory from "../../../spec/inventory.json";

const roles = ["color.surface.canvas", "color.surface.chrome", "color.surface.default", "color.text.default", "color.text.bright", "color.action.primary.bg"];
const metrics = [
  ["Canonical foundation", theme.version, "Versioned tokens, contracts and migration guidance."],
  ["Consumable inventory", inventory.components.length, "Elements, components and application compositions."],
  ["Integration routes", "03", "Install a package. Copy complete source. Map to your host."],
];
const routes = [
  ["components/", "Build with native semantics →", "Typed properties, native forms, keyboard behavior, live variants and complete dependency lists."],
  ["demo/", "See the system at work ↗", "A Vue workspace with dashboards, records, productivity tools and realistic local workflows."],
  ["agents/", "Give your agent the exact inputs →", "Pinned machine contracts, per-component imports and verified copy bundles. No screenshot interpretation required."],
  ["reference/", "Read the complete specification →", "Every normative document, token, state matrix, accessibility rule and decision in one static reference."],
];
---
<SiteLayout hero title="The j3w1 UI theme" description="Black and Rose surfaces. Rose typography, dark-red actions and square native components. A complete foundation for the apps you and your agents build.">
  <div class="site-actions">
    <a class="link link-standalone" href={withBase("components/")}>Explore components →</a>
    <a class="link link-standalone" href={withBase("demo/")}>Open Vue demo ↗</a>
    <a class="link link-standalone" href={withBase("implement/")}>Start building</a>
  </div>
  <div class="site-cards site-cards-fit site-section">
    {metrics.map(([label, value, text]) => <article class="card">
      <p class="card-meta">{label}</p>
      <strong class="site-metric">{value}</strong>
      <p class="card-body">{text}</p>
    </article>)}
  </div>
  <section class="site-section">
    <h2>The foundation, in exact values</h2>
    <div class="site-cards site-cards-fit site-swatches">
      {roles.map((role) => <div class="card">
        <div class="site-swatch" style={`background:var(${cssVar(role)})`}></div>
        <code>{defaultTokens[role].css}</code>
        <p class="card-meta">{role.replace("color.", "")}</p>
      </div>)}
    </div>
    <div class="site-actions"><a class="link link-standalone" href={withBase("foundations/")}>Typography, spacing, density and accessibility rules →</a></div>
  </section>
  <section class="site-section">
    <h2>From a single control to a complete application</h2>
    <div class="site-cards">
      {routes.map(([url, title, text]) => <a class="card card-link" href={withBase(url)}>
        <span class="card-title">{title}</span>
        <span class="card-body">{text}</span>
      </a>)}
    </div>
  </section>
  <p class="site-note">Looking for an older bookmark? <a class="link" href={withBase("reference/")}>The full reference</a> preserves existing anchors. Visits to a legacy homepage hash go there automatically when JavaScript is available.</p>
  <script>import "../scripts/legacy-hash";</script>
</SiteLayout>
