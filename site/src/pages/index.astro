---
import PortalLayout from "../layouts/PortalLayout.astro";
import { withBase } from "../lib/base";
import { defaultTokens, theme } from "../lib/theme";
const roles = ["color.surface.canvas", "color.surface.chrome", "color.surface.default", "color.text.default", "color.text.bright", "color.action.primary.bg"];
---
<PortalLayout title="The j3w1 UI theme" description="Black and Rose surfaces. Rose typography, dark-red actions and square native components. A complete foundation for the apps you and your agents build.">
  <div class="portal-actions"><a class="portal-primary" href={withBase("components/")}>Explore components →</a><a href={withBase("demo/")}>Open Vue demo ↗</a><a href={withBase("implement/")}>Start building</a></div>
  <div class="portal-grid portal-section"><div class="portal-panel"><p class="portal-eyebrow">CANONICAL FOUNDATION</p><strong class="portal-metric">{theme.version}</strong><p>Versioned tokens, contracts and migration guidance.</p></div><div class="portal-panel"><p class="portal-eyebrow">CONSUMABLE INVENTORY</p><strong class="portal-metric">67</strong><p>Elements, components and application compositions.</p></div><div class="portal-panel"><p class="portal-eyebrow">INTEGRATION ROUTES</p><strong class="portal-metric">03</strong><p>Install a package. Copy complete source. Map to your host.</p></div></div>
  <section class="portal-section"><h2>The foundation, in exact values.</h2><div class="portal-swatches">{roles.map(role => <div class="portal-panel"><div class="portal-swatch" style={`background:var(--${role.replaceAll(".", "-")})`}></div><code>{defaultTokens[role].css}</code><p>{role.replace("color.", "")}</p></div>)}</div><p><a href={withBase("foundations/")}>Typography, spacing, density and accessibility rules →</a></p></section>
  <section class="portal-section"><h2>From a single control to a complete application.</h2><div class="portal-grid">{[["components/", "Build with native semantics", "Typed properties, native forms, keyboard behavior, live variants and complete dependency lists."], ["demo/", "See the system at work", "A Vue workspace with dashboards, records, productivity tools and realistic local workflows."], ["agents/", "Give your agent the exact inputs", "Pinned machine contracts, per-component imports and verified copy bundles. No screenshot interpretation required."], ["reference/", "Read the complete specification", "Every normative document, token, state matrix, accessibility rule and decision in one static reference."]].map(([url, title, text]) => <a class="portal-card" href={withBase(url)}><h3>{title} ↗</h3><p>{text}</p></a>)}</div></section>
  <p class="portal-note">Looking for an older bookmark? <a href={withBase("reference/")}>The full reference</a> preserves existing anchors. Visits to a legacy homepage hash go there automatically when JavaScript is available.</p>
  <script>import { withBase } from "../lib/base"; if (location.hash && location.hash !== "#main") location.replace(withBase("reference/") + location.hash);</script>
</PortalLayout>
