---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SelectField from "../../components/fields/SelectField.astro";
import { withBase } from "../../lib/base";
import { theme } from "../../lib/theme";
import { anchorFor } from "../../../../scripts/lib/anchors.mjs";
import index from "../../../../packages/ui/dist/index.json";

const command = `j3w1-ui kit --components text-field,button,dialog --out ./vendor/j3w1/task`;
const key = (name: string) => anchorFor.uiExample("agent-kit", name);
const entryPoints = [
  ["Small discovery request", "ui/index.json", true],
  ["One implementation/API", "ui/contracts/<id>.json", false],
  ["Maintained native markup", "ui/examples/<id>.json", false],
  ["Complete copy files and digests", "ui/copy/<id>/manifest.json", false],
  ["Canonical meaning and eligibility", "exports/components/<id>.json", false],
  ["All implementation metadata", "ui/manifest.json", true],
] as const;
---
<SiteLayout title="Build with an agent" description="Give your agent a pinned contract and a complete implementation. The primary workflow is discovering, consuming and verifying exact j3w1 artifacts inside another application.">
  <div class="site-actions">
    <a class="link link-standalone" href={withBase("ui/index.json")}>Compact implementation index</a>
    <a class="link link-standalone" href={withBase("llms.txt")}>llms.txt</a>
    <a class="link link-standalone" href={withBase("agents/consume.md")}>Canonical consumption contract</a>
  </div>
  <section class="site-section" data-agent-kit data-version={theme.version}>
    <h2>Prepare an agent kit</h2>
    <p>Select the components your task needs. The installed CLI includes their complete dependency closure, canonical contracts, eligibility disclosures and shared rules.</p>
    <form class="site-form" data-kit-form>
      <div class="site-filters">
        <SelectField id={key("framework")} label="Framework" name="framework">
          <option value="vue">Vue</option><option value="html">HTML</option><option value="react">React</option><option value="astro">Astro</option><option value="native">Native host</option>
        </SelectField>
        <SelectField id={key("mode")} label="Consumption mode" name="mode">
          <option value="package">Package</option><option value="copy">Copy source</option><option value="mapping">Map to a host</option>
        </SelectField>
      </div>
      <SelectField id={key("components")} label="Components" name="components" multiple size="8" required help="Click an entry to toggle it. Use arrow keys to move, Space to select, Shift with arrows for a range, or Ctrl/Command+A to select all.">
        {index.components.map(({ id, name }) => <option value={id} selected={["text-field", "button", "dialog"].includes(id)}>{name} · {id}</option>)}
      </SelectField>
      <div class="site-actions">
        <button class="button" type="submit">Prepare command</button>
        <button class="button button-secondary" type="button" data-copy-kit>Copy command</button>
      </div>
    </form>
    <pre class="site-code"><code data-kit-command>{command}</code></pre>
    <p role="status" data-kit-status></p>
    <noscript><p>Use the example command above and replace its component IDs. All canonical instructions remain available below.</p></noscript>
  </section>
  <section class="site-prose">
    <h2>A bounded consumption workflow</h2>
    <ol>
      <li>Pin one release, currently <code>{theme.version}</code>, and record the artifact digest.</li>
      <li>Read the canonical consumption contract and compact implementation index.</li>
      <li>Select component IDs. Read only their canonical JSON, implementation contract and maintained examples, plus shared accessibility and eligibility rules.</li>
      <li>Prefer package mode in compatible web apps. Use complete copy bundles when source ownership is needed. Use the existing mapping workflow for incompatible/native hosts.</li>
      <li>Integrate the native markup, CSS and registration closure; bind your application data and actions.</li>
      <li>Verify your real form, keyboard, focus and lifecycle behavior. Record actual results separately from implementation availability.</li>
    </ol>
    <h2>Prepare a copy task</h2>
    <pre class="site-code"><code>{command}</code></pre>
    <p>Use the installed binary from the exact package or release tarball. The output contains all selected component closures and refuses to overwrite application files. <a class="link" href={withBase("implement/")}>Full installation and framework guide →</a></p>
    <h2>Machine entry points</h2>
    <div class="site-table-wrap">
      <table class="table">
        <thead><tr><th class="table-header" scope="col">Need</th><th class="table-header" scope="col">Artifact</th></tr></thead>
        <tbody class="table-body">
          {entryPoints.map(([need, path, linked]) => <tr class="table-row">
            <td class="table-cell">{need}</td>
            <td class="table-cell">{linked ? <a class="link" href={withBase(path)}>{path}</a> : <code>{path}</code>}</td>
          </tr>)}
        </tbody>
      </table>
    </div>
    <p class="site-note">Site URLs help humans explore the current release. For reproducible agent fetches, use the matching immutable release tag and its published digests. Never combine current-site examples with a different installed version.</p>
    <h2>Mapping compatibility</h2>
    <p>The existing <a class="link" href={withBase("kit/")}>canonical task kit</a>, lock format and portability disclosures remain available. An official package dependency is recorded alongside that integration evidence; it does not pretend to be a newly verified native port.</p>
  </section>
</SiteLayout>
<script>import "../../scripts/agent-kit";</script>
