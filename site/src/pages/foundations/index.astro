---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import DocSection from "../../components/DocSection.astro";

const docs = await getCollection("docs");
---
<SiteLayout title="Foundations" description="True Black / Rose is the permanent default: black canvas, warm dark panels, the original rose foregrounds and dark-red actions. Exact roles and accessibility rules remain authoritative.">
  <div class="site-prose">
    {["identity", "foundations", "accessibility"].map((id) => <DocSection entry={docs.find((doc) => doc.data.id === id)} />)}
  </div>
</SiteLayout>
