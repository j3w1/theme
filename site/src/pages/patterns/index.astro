---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { withBase } from "../../lib/base";

const entries = (await getCollection("components")).filter((c) => ["patterns", "compositions"].includes(c.data.family) || ["admin-form", "settings-panel", "filterable-table", "compact-dashboard", "file-browser", "i3-chrome"].includes(c.id));
const cards = [...entries.map((c) => [`components/${c.id}/`, c.data.name, c.data.summary]), ["patterns/validation-recovery/", "Validation and recovery", "Errors, review, correction and confirmation across a native form."]];
---
<SiteLayout title="Application patterns" description="Compose native controls into complete workflows. Each pattern includes its behavior, nested component registrations, styles and token dependencies.">
  <div class="site-cards">
    {cards.map(([path, name, summary]) => <a class="card card-link" href={withBase(path)}>
      <span class="card-title">{name} →</span>
      <span class="card-body">{summary}</span>
    </a>)}
  </div>
</SiteLayout>
