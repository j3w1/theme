---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { withBase } from "../../lib/base";

const entry = (await getCollection("docs")).find((item) => item.data.id === "figma-bridge");
const { Content } = await render(entry);
---
<SiteLayout title="Figma Variables bridge" description="Pinned source values, explicit diffs and an external receipt for safe one-way import." revision>
  <div class="site-actions">
    <a class="link link-standalone" href={withBase("exports/figma/importer.mjs")} download>Download the actual Variables adapter</a>
    <a class="link link-standalone" href="https://github.com/j3w1/theme/issues/15">Import verification evidence ↗</a>
  </div>
  <div class="site-prose">
    <h2>Mapping, operation and evidence</h2>
    <Content />
  </div>
</SiteLayout>
