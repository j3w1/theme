---
import "../styles/tokens.generated.css";
import "../styles/base.css";
import "../styles/site.css";
import "../styles/hex-swatches.css";
import "../styles/print.css";
import "../styles/tools.css";
import PortalLayout from "./PortalLayout.astro";
import { withBase } from "../lib/base";
import { usageRevision } from "../lib/usage";
const { title, description } = Astro.props;
---
<PortalLayout title={title} description={description} density="compact">
      <nav aria-label="Theme tools"><a href={withBase("")}>Specification</a> · <a href={withBase("tokens/")}>Token usage</a> · <a href={withBase("recipes/")}>Recipes</a> · <a href={withBase("kit/")}>Task kit</a> · <a href={withBase("workbench/")}>Workbench</a> · <a href={withBase("releases/")}>Release comparison</a></nav>
      <p class="stamp">{usageRevision ? <>Source revision <code>{usageRevision}</code></> : "Local build: source locations are relative to this checkout; no published revision is claimed."}</p>
    <div class="tool-main"><slot /></div>
    <footer class="tool-main"><a href={withBase("ports/")}>Port capabilities and mapping evidence</a> · <a href={withBase("patterns/validation-recovery/")}>Validation and recovery</a> · <a href={withBase("builder/")}>Form builder</a> · <a href={withBase("figma/")}>Figma Variables bridge</a></footer>
</PortalLayout>
