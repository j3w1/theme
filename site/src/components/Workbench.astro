---
import IssueDraft from "./IssueDraft.astro";
import SelectField from "./fields/SelectField.astro";
import TextField from "./fields/TextField.astro";
import Checkbox from "./fields/Checkbox.astro";
import { anchorFor } from "../../../scripts/lib/anchors.mjs";
import { renderSpecimenMarkup, stateAttributes } from "../../../scripts/lib/specimen-markup.mjs";
import { withBase } from "../lib/base";
import { newIssueUrl } from "../lib/revision";
const { data } = Astro.props;
const c = data.contract;
const { fragments, ...metadata } = data;
const key = (name: string) => anchorFor.workbench(c.id, name);
const colors = Object.entries(data.tokens.default).filter(([, token]: any) => token.type === "color").map(([path]) => path);
---
<section class="workbench" data-workbench data-workbench-data={JSON.stringify(metadata)} data-preview-url={withBase(`preview/${c.id}/`)}>
  <div class="site-actions">
    <a class="link link-standalone" href={`${withBase("reference/")}#${anchorFor.component(c.id)}`}>Component specification</a>
    <a class="link link-standalone" href={withBase(`preview/${c.id}/`)} data-open-preview>Open isolated preview</a>
  </div>
  <p>Controls use maintained specimens. A forced focus ring is a visual simulation; it does not move keyboard focus. Profile previews keep their published approval status. Sample text stays in this page unless explicitly included in a shared link.</p>
  <p data-revision-status role="status">{data.revision ? `Actual build: ${data.revision}` : "Actual build: local and unpinned."} Source snapshot: <code>{data.sourceDigest}</code></p>
  <div class="site-actions">
    <a class="link link-standalone" href={withBase(`exports/components/${c.id}.json`)}>Machine contract</a>
    <a class="link link-standalone" href={newIssueUrl(`${c.id}: describe the issue`)}>Report an issue without JavaScript</a>
  </div>
  <div class="workbench-fallback">
    <h2>Canonical specimen</h2>
    <div data-density="compact" data-profile="default" set:html={renderSpecimenMarkup(fragments.default, `workbench-static-${c.id}`)} />
    <p>JavaScript adds the controls below; the complete specification and this specimen remain available without it.</p>
  </div>
  <form class="site-filters js-only" data-workbench-controls>
    <SelectField id={key("variant")} label="Variant" name="variant">{c.variants.map((v: any) => <option value={v.id}>{v.name}</option>)}</SelectField>
    <SelectField id={key("state")} label="Initial state" name="state">{c.states.map((state: string) => <option value={state}>{state}</option>)}</SelectField>
    <SelectField id={key("density")} label="Density" name="density">{c.sizes.map((size: string) => <option value={size}>{size}</option>)}</SelectField>
    <SelectField id={key("profile")} label="Profile" name="profile">{data.profiles.map((profile: any) => <option value={profile.id}>{profile.id} — {profile.status}</option>)}</SelectField>
    <SelectField id={key("direction")} label="Direction" name="direction"><option value="ltr">Left to right</option><option value="rtl">Right to left</option></SelectField>
    <SelectField id={key("fixture")} label="Text fixture" name="fixture">
      <option value="canonical">Canonical</option><option value="en">English</option><option value="es">Spanish</option>
      <option value="zh">Chinese</option><option value="ar">Arabic</option><option value="long">Long label</option>
    </SelectField>
    <TextField id={key("label")} label={data.bindings.labelName} name="label" maxlength="256" placeholder="Canonical fixture text" autocomplete="off" />
    {data.bindings.help && <TextField id={key("help")} label="Help / description" name="help" maxlength="512" placeholder="Canonical fixture text" autocomplete="off" />}
    <SelectField id={key("preset")} label="Viewport preset" data-width-preset>
      <option value="320">320 px</option><option value="360">360 px</option><option value="640" selected>640 px</option>
      <option value="1280">Wide — 1280 px</option><option value="custom">Custom</option>
    </SelectField>
    <TextField id={key("width")} label="Viewport width (CSS px)" name="width" type="number" min="320" max="1280" step="1" value="640" required />
    <SelectField id={key("motion")} label="Motion preference" name="motion"><option value="system">System preference</option><option value="reduced">Reduced motion</option></SelectField>
    <SelectField id={key("part")} label="Inspect anatomy part" name="part"><option value="">No overlay</option>{c.anatomy.map((item: any) => <option value={item.part}>{item.part}</option>)}</SelectField>
    <button type="button" class="button button-secondary" data-workbench-reset>Reset specimen</button>
  </form>
  <p data-workbench-status role="status"></p>
  <div class="js-only workbench-live">
    <h2>Live specimen</h2>
    <p>The iframe has its own viewport. Wide previews scroll inside this inspection region. Resizing is not browser zoom, device emulation, or an accessibility pass. Initial configuration is reproducible; subsequent interactions are temporary.</p>
    <Checkbox data-compare-enabled>Compare the same specimen in another environment</Checkbox>
    <div class="viewport-grid" data-viewport-grid><div>
    <div class="viewport-scroll" tabindex="0" role="region" aria-label="Scrollable preview viewport"><iframe title={`${c.name} isolated specimen`} data-workbench-frame loading="lazy" width="640" height="560"></iframe></div>
    <p data-viewport-report role="status"></p></div>
    <div data-comparison hidden>
      <div class="site-filters">
        <SelectField id={key("compare-width")} label="Comparison width" data-compare-width><option value="320">320 px</option><option value="360">360 px</option><option value="640" selected>640 px</option><option value="1280">1280 px</option></SelectField>
        <SelectField id={key("compare-density")} label="Comparison density" data-compare-density><option value="compact">Compact</option><option value="comfortable">Comfortable</option></SelectField>
        <SelectField id={key("compare-direction")} label="Comparison direction" data-compare-direction><option value="ltr">Left to right</option><option value="rtl">Right to left</option></SelectField>
        <SelectField id={key("compare-motion")} label="Comparison motion" data-compare-motion><option value="reduced">Reduced</option><option value="system">System preference</option></SelectField>
      </div>
      <div class="viewport-scroll" tabindex="0" role="region" aria-label="Scrollable comparison viewport"><iframe title={`${c.name} comparison specimen`} data-comparison-frame loading="lazy" width="640" height="560"></iframe></div>
      <p data-comparison-report role="status"></p>
      <p>Comparison settings stay local. Shared links describe the primary specimen.</p>
    </div>
    </div>
    <h2>Anatomy and measurements</h2>
    <p data-part-description>Select a documented part. The overlay does not capture input or change layout.</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Anatomy measurements">
      <table class="table">
        <thead><tr><th class="table-header" scope="col">Metric / mapping</th><th class="table-header" scope="col">Declared role</th><th class="table-header" scope="col">Resolved value</th><th class="table-header" scope="col">Measured value / result</th></tr></thead>
        <tbody class="table-body" data-measurements></tbody>
      </table>
    </div>
    <h2>Contrast lab</h2>
    <p>Uses the specification’s contrast engine. Choose a context explicitly; a ratio does not establish semantic suitability or overall accessibility. Large text means at least 18.66px bold or 24px regular. Alpha requires the selected opaque underlay.</p>
    <form class="site-filters" data-contrast-controls>
      <SelectField id={key("pair")} label="Declared pair" name="pair"><option value="custom">Custom comparison</option>{c.contrast.map((pair: any, i: number) => <option value={i} selected={i === 0}>{pair.label}</option>)}</SelectField>
      <SelectField id={key("fg")} label="Foreground role" name="fg">{colors.map((path) => <option value={path}>{path}</option>)}</SelectField>
      <SelectField id={key("bg")} label="Background role" name="bg">{colors.map((path) => <option value={path}>{path}</option>)}</SelectField>
      <SelectField id={key("underlay")} label="Opaque underlay" name="underlay">{colors.filter((path) => (data.tokens.default[path].value.alpha ?? 1) === 1).map((path) => <option value={path} selected={path === "color.surface.default"}>{path}</option>)}</SelectField>
      <SelectField id={key("context")} label="Threshold context" name="context"><option value="declared">Declared pair threshold</option><option value="text">Normal text — 4.5:1</option><option value="large">Large text — 3:1</option><option value="ui">UI boundary — 3:1</option></SelectField>
    </form>
    <div data-contrast-result role="status"></div>
    <TextField id={key("contrast-copy")} label="Contrast result with build context" rows={4} data-contrast-copy readonly />
    <div class="site-actions"><button type="button" class="button button-secondary" data-copy-contrast>Copy contrast result</button></div>
    <h2>Motion inspection</h2>
    <p>{data.bindings.motion ? "Replay the maintained hover background transition. Inspection speed is explicitly slowed to one quarter; system reduced motion always wins. Playback stops when the workbench is hidden." : "This specimen has no replayable maintained transition here. Dialog opacity is specified for capable hosts, but this reference does not add an opening animation. The loading glyph remains static."}</p>
    <p data-motion-report></p>
    {data.bindings.motion && <div class="site-actions">
      <button type="button" class="button button-secondary" data-replay="normal">Replay at normal speed</button>
      <button type="button" class="button button-secondary" data-replay="slow">Replay at ¼ speed</button>
      <button type="button" class="button button-secondary" data-replay="stop">Stop playback</button>
      <button type="button" class="button button-secondary" data-compare-reduced>Compare normal and reduced outcomes</button>
    </div>}
    <h2>Share this configuration</h2>
    <Checkbox data-include-text>Include entered label and help text in the displayed share payload</Checkbox>
    <TextField id={key("share-payload")} label="Review structured payload" rows={5} data-share-payload readonly />
    <TextField id={key("share-link")} label="Preview link" data-share-link readonly />
    <div class="site-actions">
      <button type="button" class="button button-secondary" data-copy-config>Copy configuration</button>
      <button type="button" class="button button-secondary" data-copy-link>Copy preview link</button>
    </div>
    <IssueDraft id={c.id} />
  </div>
  {data.bindings.motion && <div class="motion-static">
    <h2>Static motion endpoints</h2>
    <p>Default and documented hover backgrounds, available without JavaScript. Property: {data.motion.property}; duration: {data.tokens.default[data.motion.role].css} from {data.motion.role}; easing: {data.motion.easing}. Reduced motion uses instant endpoints.</p>
    <div class="motion-specimens">
      {["default", "hover"].map((state) => <div class="table-scroll" tabindex="0" role="region" aria-label={`${state} motion endpoint`}>
        <h3>{state}</h3>
        <div aria-hidden="true" data-specimen set:html={`<div ${stateAttributes(state)}>${renderSpecimenMarkup(fragments.default, `motion-${c.id}-${state}`, { state, inert: true })}</div>`} />
      </div>)}
    </div>
  </div>}
</section>
<script>import "../scripts/workbench";</script>
