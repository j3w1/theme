---
/* Rows = declared states, columns = variants. Every cell is a static clone
   of the demo fragment wrapped in [data-state]; forced-state selectors in the
   component CSS render the state without JavaScript. Only the default cell
   is live in the tab order; the others are aria-hidden with tabindex="-1"
   so keyboard users are not walked through dozens of copies. */

import { renderSpecimenMarkup, stateAttributes } from "../../../scripts/lib/specimen-markup.mjs";

interface Props {
  id: string;
  states: string[];
  variants: { id: string; name: string }[];
  fragments: Map<string, string>;
  sizes: string[];
}

const { id, states, variants, fragments, sizes } = Astro.props;

---

<div class="block" id={`${id}-states`}>
  <h4>State matrix</h4>
  <p class="family-description">Every declared state and combination, statically rendered; the default cell is live. Sizes: {sizes.join(", ")}<span class="js-only"> (switch with the density control above)</span>.</p>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table">
    <table class="matrix">
      <thead>
        <tr>
          <th scope="col">State</th>
          {variants.map((v) => <th scope="col">{v.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {states.map((state) => (
          <tr>
            <th scope="row"><code>{state}</code></th>
            {variants.map((v) => {
              const suffix = `${v.id}-${state.replace(/[^a-z0-9]+/g, "-")}`;
              const live = state === "default";
              const body = renderSpecimenMarkup(fragments.get(v.id) ?? "", suffix, { state, inert: !live });
              return (
                <td>
                  <div class={`demo ${id}-demo`} data-component={id} data-variant={v.id} set:html={state.split("+").includes("disabled")
                    ? `<fieldset class="matrix-disabled" disabled aria-hidden="true"><div ${stateAttributes(state)}>${body}</div></fieldset>`
                    : `<div ${stateAttributes(state)}${live ? "" : ' aria-hidden="true"'}>${body}</div>`} />
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
