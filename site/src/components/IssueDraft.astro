---
import TextField from "./fields/TextField.astro";
import Checkbox from "./fields/Checkbox.astro";
import { anchorFor } from "../../../scripts/lib/anchors.mjs";
import { issueSearchUrl, newIssueUrl } from "../lib/revision";

const { id, context = null } = Astro.props;
const key = (name: string) => anchorFor.workbench(id, `report-${name}`);
const fields = [["expected", "Expected"], ["actual", "Actual"], ["steps", "Steps to reproduce"], ["evidence", "Evidence notes"]];
---
<section data-issue-draft data-report-context={JSON.stringify(context)}>
  <h2>Prepare a public issue draft</h2>
  <p>Describe the problem and review the resulting draft. Entered specimen text, storage, screenshots, and unrelated URLs are not collected. No issue is submitted automatically.</p>
  <div class="site-actions">
    <a class="link link-standalone" href={newIssueUrl(`${id}: describe the issue`)}>Open GitHub directly (also works without JavaScript)</a>
    <a class="link link-standalone" href={issueSearchUrl(`is:issue ${id}`)}>Search existing issues</a>
  </div>
  <form class="site-form js-only" data-issue-form>
    {fields.map(([name, label]) => <TextField id={key(name)} label={label} name={name} maxlength="1600" rows={2} />)}
    <div class="site-actions"><button type="submit" class="button">Prepare draft for review</button></div>
    <TextField id={key("body")} label="Public issue body" rows={8} data-issue-body readonly />
    <Checkbox data-review-issue>I reviewed this draft for public sharing</Checkbox>
    <div class="site-actions">
      <a class="link link-standalone" data-open-issue aria-disabled="true" target="_blank" rel="noopener noreferrer">Open GitHub composer</a>
      <button type="button" class="button button-secondary" data-copy-issue disabled>Copy draft</button>
      <button type="button" class="button button-tertiary" data-cancel-issue>Clear draft</button>
    </div>
    <p data-issue-status role="status"></p>
  </form>
</section>
<script>import "../scripts/issue-draft";</script>
