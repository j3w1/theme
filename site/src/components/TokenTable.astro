---
/* Compact default-profile roles on the hub; other profiles live on /tokens/. */
import { anchors, cssVar, tokensInGroup } from "../lib/theme";
import { withBase } from "../lib/base";
import { tokenUrl } from "../lib/usage";
import Eligibility from "./Eligibility.astro";

interface Props { prefix: string; title: string; id?: string; grid?: boolean }
const { prefix, title, id, grid = false } = Astro.props;
const rows = tokensInGroup(prefix);
const primitives = prefix === "color.primitive.";
---
<div class="block" id={id ?? anchors.token(prefix.replace(/\.$/, ""))}>
  <h4>{title}</h4>
  {primitives ? <p class="primitive-index">{rows.map(([path]) => <a class="link" id={anchors.token(path)} data-legacy-target href={withBase(`tokens/#${anchors.token(path)}`)}><code>{path.replace(prefix, "")}</code></a>)}</p> : grid ? (
    <div class="swatch-grid">
      {rows.map(([path, token]) => <div class="swatch-row" id={anchors.token(path)}>
        <div class="paint" style={token.type === "color" ? `background: var(${cssVar(path)})` : ""} aria-hidden="true"></div>
        <div class="label">
          <a href={tokenUrl(path)} data-token={path}><code>{path.replace(prefix, "")}</code></a>{" "}
          <span class="copy-target"><span class="value">{token.css}</span><button type="button" class="button button-tertiary js-only" data-copy={token.css} aria-label={`Copy ${path}`}>Copy</button></span>
          <code class="value">{cssVar(path)}</code>
          <Eligibility token={token} />
        </div>
      </div>)}
    </div>
  ) : (
    <div class="table-scroll" tabindex="0" role="region" aria-label={`${title} roles`}>
      <table class="spec-table token-table compact-token-table">
        <thead><tr><th scope="col">Role</th><th scope="col">CSS variable</th><th scope="col">Default value</th><th scope="col">Status / eligibility</th></tr></thead>
        <tbody>{rows.map(([path, token]) => <tr id={anchors.token(path)}>
          <td><a href={tokenUrl(path)} data-token={path}><code>{path}</code></a></td>
          <td><code>{cssVar(path)}</code></td>
          <td><code>{token.css}</code></td>
          <td><Eligibility token={token} /></td>
        </tr>)}</tbody>
      </table>
    </div>
  )}
</div>
