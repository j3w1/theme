{
  "schemaVersion": 1,
  "id": "validation-recovery",
  "decisionId": "D-020",
  "components": [
    "admin-form",
    "text-field",
    "textarea",
    "select",
    "checkbox",
    "alert",
    "button",
    "table"
  ],
  "stages": [
    "editing",
    "invalid",
    "review",
    "busy",
    "success"
  ],
  "transitions": [
    {
      "from": "editing",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "invalid",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "review",
      "event": "edit",
      "to": [
        "editing"
      ]
    },
    {
      "from": "review",
      "event": "confirm",
      "to": [
        "busy"
      ]
    },
    {
      "from": "busy",
      "event": "complete",
      "to": [
        "success"
      ]
    },
    {
      "from": "success",
      "event": "edit",
      "to": [
        "editing"
      ]
    }
  ],
  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "help": "Shown in the example record. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "hostname",
      "type": "text",
      "label": "Hostname",
      "help": "Lowercase letters, digits and hyphens. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "role",
      "type": "select",
      "label": "Role",
      "help": "An example role, with no account permissions attached.",
      "required": false,
      "options": [
        {
          "id": "dev",
          "label": "Development"
        },
        {
          "id": "build",
          "label": "Build agent"
        },
        {
          "id": "kiosk",
          "label": "Kiosk"
        }
      ]
    },
    {
      "id": "notes",
      "type": "textarea",
      "label": "Notes",
      "help": "Plain text retained only in this page.",
      "required": false,
      "options": []
    },
    {
      "id": "enabled",
      "type": "checkbox",
      "label": "Enable after saving",
      "help": "Demonstrates a boolean value; no real record is enabled.",
      "required": false,
      "options": []
    }
  ],
  "fixtures": {
    "invalid": {
      "name": "ws-07",
      "hostname": "ws-07",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    },
    "valid": {
      "name": "ws-08",
      "hostname": "ws-08",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    }
  },
  "validation": "Required values, supported choices, a bounded text length, and explicit local workstation fixture conflicts. Never server-side validation.",
  "announcements": "Errors update on submit, not on input. The summary receives focus; links focus the named field. Review, busy and success update the status once per transition.",
  "tests": [
    "tests/form-model.test.js",
    "tests/browser/validation-recovery.spec.js"
  ],
  "limits": [
    "Local simulation only; no request, account, database or persistence.",
    "Busy requires an explicit simulation-completion event; a submit click is not success.",
    "Automated keyboard/DOM/axe evidence does not claim a manual screen-reader or user-research pass."
  ],
  "version": "1.2.0",
  "theme": {
    "name": "j3w1-theme",
    "version": "1.2.0",
    "profile": "default",
    "sourceDigest": "sha256-66VP2q/UTYL2qj3wl3S/Nz0Ev5vYRzMpohnSMtDeDvk="
  },
  "componentDigests": {
    "admin-form": "sha256-ykplNGs/qcf9H03nwX/YL9FSinAfw2uwEXtstA+xDWU=",
    "alert": "sha256-Kf8AXidGaHUkQEfVzozQugNzPfinPe65FpuBRXEWIIM=",
    "button": "sha256-U1nOcUYyz7IyX+ypzODC6Wkkl/X5NWcIVh65Wbz9dCY=",
    "checkbox": "sha256-mN0lr2++OCgE0qOL5nlZCtbGY4n3p2Yf1yDr1iDg1uI=",
    "radio-group": "sha256-0+35LWqJHVK5jNo4GVFSX1+PC4NMhGQzMtHZnwJ+Hm8=",
    "select": "sha256-ztzI03wlWo5i8UNUD9yiRknMr9YKCqEisdXab7VehLY=",
    "table": "sha256-SSfF45hyrGt1hfqVkCCFXkpTowdDP9lX5DYibP+OVoM=",
    "text-field": "sha256-oMD/fPoZvUXukPSQj5uE2ewPknrcg0PVR2l6uevLfLY=",
    "textarea": "sha256-a75RQKVcoLzccsogE8zaiULKTlWtGJ7v7Doau1prsKc="
  }
}
