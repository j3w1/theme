{
  "schemaVersion": 1,
  "id": "validation-recovery",
  "decisionId": "D-020",
  "components": [
    "admin-form",
    "text-field",
    "textarea",
    "select",
    "checkbox",
    "alert",
    "button",
    "table"
  ],
  "stages": [
    "editing",
    "invalid",
    "review",
    "busy",
    "success"
  ],
  "transitions": [
    {
      "from": "editing",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "invalid",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "review",
      "event": "edit",
      "to": [
        "editing"
      ]
    },
    {
      "from": "review",
      "event": "confirm",
      "to": [
        "busy"
      ]
    },
    {
      "from": "busy",
      "event": "complete",
      "to": [
        "success"
      ]
    },
    {
      "from": "success",
      "event": "edit",
      "to": [
        "editing"
      ]
    }
  ],
  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "help": "Shown in the example record. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "hostname",
      "type": "text",
      "label": "Hostname",
      "help": "Lowercase letters, digits and hyphens. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "role",
      "type": "select",
      "label": "Role",
      "help": "An example role, with no account permissions attached.",
      "required": false,
      "options": [
        {
          "id": "dev",
          "label": "Development"
        },
        {
          "id": "build",
          "label": "Build agent"
        },
        {
          "id": "kiosk",
          "label": "Kiosk"
        }
      ]
    },
    {
      "id": "notes",
      "type": "textarea",
      "label": "Notes",
      "help": "Plain text retained only in this page.",
      "required": false,
      "options": []
    },
    {
      "id": "enabled",
      "type": "checkbox",
      "label": "Enable after saving",
      "help": "Demonstrates a boolean value; no real record is enabled.",
      "required": false,
      "options": []
    }
  ],
  "fixtures": {
    "invalid": {
      "name": "ws-07",
      "hostname": "ws-07",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    },
    "valid": {
      "name": "ws-08",
      "hostname": "ws-08",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    }
  },
  "validation": "Required values, supported choices, a bounded text length, and explicit local workstation fixture conflicts. Never server-side validation.",
  "announcements": "Errors update on submit, not on input. The summary receives focus; links focus the named field. Review, busy and success update the status once per transition.",
  "tests": [
    "tests/form-model.test.js",
    "tests/browser/validation-recovery.spec.js"
  ],
  "limits": [
    "Local simulation only; no request, account, database or persistence.",
    "Busy requires an explicit simulation-completion event; a submit click is not success.",
    "Automated keyboard/DOM/axe evidence does not claim a manual screen-reader or user-research pass."
  ],
  "version": "2.0.0",
  "theme": {
    "name": "j3w1-theme",
    "version": "2.0.0",
    "profile": "default",
    "sourceDigest": "sha256-hqrrwIICe0OhLBRaMjyEQbPu2Wc4ke1NI4yLcHFnAsA="
  },
  "componentDigests": {
    "admin-form": "sha256-mRkQxiPjFj3d8o4SsiUYOdObf4wwG2h7dt9iKSYs2Cs=",
    "alert": "sha256-JPZWZ9/Qr7cCoQt5OLewSZdGsB4sz0gU/qJqfP0qe0g=",
    "button": "sha256-szpN/TAKRv6m/qXOcgV/y+FtC/n4dqiZID7LIjR6/7Q=",
    "checkbox": "sha256-bJEr0kmZ/uIc71DLMPwCfnU3F5qYpIolXfZh3jJ1KR4=",
    "radio-group": "sha256-Hjg/D6OFRJwRNPNjlE1U6f2V6USpMXLySbaKec8GPjQ=",
    "select": "sha256-Kj2nirEQ7j3EQJBxXpemW3iabPcO12ufGsDdgg41axI=",
    "table": "sha256-GMqDu6VwI5BJ/2R2Y16PlEeHCpRNXTmmqW986NE7Afo=",
    "text-field": "sha256-QHOi1qe5MQ711+JoMovfyDVJDbSKwNjg6Fc/hqaf5ZY=",
    "textarea": "sha256-d3l5IOcbWrny2+hCqtik/mx2cDf4SWVLVzRumHGrCSk="
  }
}
