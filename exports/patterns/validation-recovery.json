{
  "schemaVersion": 1,
  "id": "validation-recovery",
  "decisionId": "D-020",
  "components": [
    "admin-form",
    "text-field",
    "textarea",
    "select",
    "checkbox",
    "alert",
    "button",
    "table"
  ],
  "stages": [
    "editing",
    "invalid",
    "review",
    "busy",
    "success"
  ],
  "transitions": [
    {
      "from": "editing",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "invalid",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "review",
      "event": "edit",
      "to": [
        "editing"
      ]
    },
    {
      "from": "review",
      "event": "confirm",
      "to": [
        "busy"
      ]
    },
    {
      "from": "busy",
      "event": "complete",
      "to": [
        "success"
      ]
    },
    {
      "from": "success",
      "event": "edit",
      "to": [
        "editing"
      ]
    }
  ],
  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "help": "Shown in the example record. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "hostname",
      "type": "text",
      "label": "Hostname",
      "help": "Lowercase letters, digits and hyphens. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "role",
      "type": "select",
      "label": "Role",
      "help": "An example role, with no account permissions attached.",
      "required": false,
      "options": [
        {
          "id": "dev",
          "label": "Development"
        },
        {
          "id": "build",
          "label": "Build agent"
        },
        {
          "id": "kiosk",
          "label": "Kiosk"
        }
      ]
    },
    {
      "id": "notes",
      "type": "textarea",
      "label": "Notes",
      "help": "Plain text retained only in this page.",
      "required": false,
      "options": []
    },
    {
      "id": "enabled",
      "type": "checkbox",
      "label": "Enable after saving",
      "help": "Demonstrates a boolean value; no real record is enabled.",
      "required": false,
      "options": []
    }
  ],
  "fixtures": {
    "invalid": {
      "name": "ws-07",
      "hostname": "ws-07",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    },
    "valid": {
      "name": "ws-08",
      "hostname": "ws-08",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    }
  },
  "validation": "Required values, supported choices, a bounded text length, and explicit local workstation fixture conflicts. Never server-side validation.",
  "announcements": "Errors update on submit, not on input. The summary receives focus; links focus the named field. Review, busy and success update the status once per transition.",
  "tests": [
    "tests/form-model.test.js",
    "tests/browser/validation-recovery.spec.js"
  ],
  "limits": [
    "Local simulation only; no request, account, database or persistence.",
    "Busy requires an explicit simulation-completion event; a submit click is not success.",
    "Automated keyboard/DOM/axe evidence does not claim a manual screen-reader or user-research pass."
  ],
  "version": "4.0.0",
  "theme": {
    "name": "j3w1-theme",
    "version": "4.0.0",
    "profile": "default",
    "sourceDigest": "sha256-MmChX5ZeKCqPdvLvL3GaWfQfldAZS4+e7oFTJ3bZO1E="
  },
  "componentDigests": {
    "admin-form": "sha256-RR07gVWG6gelPVEVFF83kR+/QhadqNRiYmOeW1tAYBE=",
    "alert": "sha256-n+DXKQ5u9Im3i+34seRmCMNjXsX7oVXwRdPNQGj+olI=",
    "button": "sha256-z1mtoexOgIw0lQo50YK45QTKkFo4BWPQilUgNHxXBtg=",
    "checkbox": "sha256-XxW4G7fyZlMc9Tkh0Bil4EbVJrvJGB9gG2D+tA2iq5I=",
    "radio-group": "sha256-OtroHrr0DI86mIeIhzDqDqThGziGxOoPhuQTEeFuBvY=",
    "select": "sha256-tSo+fhGM7BgXL43kgf+rBPoelZXfQY3Nb4iVgosuS0Q=",
    "table": "sha256-M+a1axv7DIvjKf0iZ+N1u2/nak4Zh/TgzE3fh6sYUUs=",
    "text-field": "sha256-nP2yJAOGnd5o5N9mrayvK1PRLMnE+JvHKhP6KqZhbq8=",
    "textarea": "sha256-Hm8QliVeosgLymorx2C/rOSlopUoRE5XYUJTDZOXbXg="
  }
}
