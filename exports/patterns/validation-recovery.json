{
  "schemaVersion": 1,
  "id": "validation-recovery",
  "decisionId": "D-020",
  "components": [
    "admin-form",
    "text-field",
    "textarea",
    "select",
    "checkbox",
    "alert",
    "button",
    "table"
  ],
  "stages": [
    "editing",
    "invalid",
    "review",
    "busy",
    "success"
  ],
  "transitions": [
    {
      "from": "editing",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "invalid",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "review",
      "event": "edit",
      "to": [
        "editing"
      ]
    },
    {
      "from": "review",
      "event": "confirm",
      "to": [
        "busy"
      ]
    },
    {
      "from": "busy",
      "event": "complete",
      "to": [
        "success"
      ]
    },
    {
      "from": "success",
      "event": "edit",
      "to": [
        "editing"
      ]
    }
  ],
  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "help": "Shown in the example record. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "hostname",
      "type": "text",
      "label": "Hostname",
      "help": "Lowercase letters, digits and hyphens. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "role",
      "type": "select",
      "label": "Role",
      "help": "An example role, with no account permissions attached.",
      "required": false,
      "options": [
        {
          "id": "dev",
          "label": "Development"
        },
        {
          "id": "build",
          "label": "Build agent"
        },
        {
          "id": "kiosk",
          "label": "Kiosk"
        }
      ]
    },
    {
      "id": "notes",
      "type": "textarea",
      "label": "Notes",
      "help": "Plain text retained only in this page.",
      "required": false,
      "options": []
    },
    {
      "id": "enabled",
      "type": "checkbox",
      "label": "Enable after saving",
      "help": "Demonstrates a boolean value; no real record is enabled.",
      "required": false,
      "options": []
    }
  ],
  "fixtures": {
    "invalid": {
      "name": "ws-07",
      "hostname": "ws-07",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    },
    "valid": {
      "name": "ws-08",
      "hostname": "ws-08",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    }
  },
  "validation": "Required values, supported choices, a bounded text length, and explicit local workstation fixture conflicts. Never server-side validation.",
  "announcements": "Errors update on submit, not on input. The summary receives focus; links focus the named field. Review, busy and success update the status once per transition.",
  "tests": [
    "tests/form-model.test.js",
    "tests/browser/validation-recovery.spec.js"
  ],
  "limits": [
    "Local simulation only; no request, account, database or persistence.",
    "Busy requires an explicit simulation-completion event; a submit click is not success.",
    "Automated keyboard/DOM/axe evidence does not claim a manual screen-reader or user-research pass."
  ],
  "version": "4.0.0",
  "theme": {
    "name": "j3w1-theme",
    "version": "4.0.0",
    "profile": "default",
    "sourceDigest": "sha256-mKTBzdPJfZvkgtYFTGC3tgyX+JltZDoEDZW81bCBleo="
  },
  "componentDigests": {
    "admin-form": "sha256-mGq6p24iD7FFWXPtEqN+9D62hVLhGunTPB+v373mf8M=",
    "alert": "sha256-nicIQjtEYAkSo61Zi/SS6LXgPajR9yfZ8vimmGuEE2Y=",
    "button": "sha256-PWCXNzWleZkVQtwsKjeiZECQDmnhH/Q0Xei1e3o2yd8=",
    "checkbox": "sha256-oa8Jwj73IRfL1XjYWMblXglksU/uF4Lkvmf7YdSD3XU=",
    "radio-group": "sha256-IwlxKnFzOGjJ9192Y9K+ezX+aAtrMABa6ePssB7bwK0=",
    "select": "sha256-vWnr6N316JDA9ft7J+pW8auONnRwNEpcfUDVkM5RT4A=",
    "table": "sha256-fmpDW3/zcv46PG5X3HtxDsdie6Zuiwl2eVpesjuC1HE=",
    "text-field": "sha256-ZK7PcxjPvBgXx+hTP97rCBTSPSEjO/1nR6MRy918hSc=",
    "textarea": "sha256-4x/x6eXXo2aao/Dx5gSPrlKcXj6ztblnltTmrhpzm4g="
  }
}
