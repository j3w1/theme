{
  "schemaVersion": 1,
  "id": "validation-recovery",
  "decisionId": "D-020",
  "components": [
    "admin-form",
    "text-field",
    "textarea",
    "select",
    "checkbox",
    "alert",
    "button",
    "table"
  ],
  "stages": [
    "editing",
    "invalid",
    "review",
    "busy",
    "success"
  ],
  "transitions": [
    {
      "from": "editing",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "invalid",
      "event": "submit",
      "to": [
        "invalid",
        "review"
      ]
    },
    {
      "from": "review",
      "event": "edit",
      "to": [
        "editing"
      ]
    },
    {
      "from": "review",
      "event": "confirm",
      "to": [
        "busy"
      ]
    },
    {
      "from": "busy",
      "event": "complete",
      "to": [
        "success"
      ]
    },
    {
      "from": "success",
      "event": "edit",
      "to": [
        "editing"
      ]
    }
  ],
  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "help": "Shown in the example record. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "hostname",
      "type": "text",
      "label": "Hostname",
      "help": "Lowercase letters, digits and hyphens. The fixture reserves ws-07.",
      "required": true,
      "options": []
    },
    {
      "id": "role",
      "type": "select",
      "label": "Role",
      "help": "An example role, with no account permissions attached.",
      "required": false,
      "options": [
        {
          "id": "dev",
          "label": "Development"
        },
        {
          "id": "build",
          "label": "Build agent"
        },
        {
          "id": "kiosk",
          "label": "Kiosk"
        }
      ]
    },
    {
      "id": "notes",
      "type": "textarea",
      "label": "Notes",
      "help": "Plain text retained only in this page.",
      "required": false,
      "options": []
    },
    {
      "id": "enabled",
      "type": "checkbox",
      "label": "Enable after saving",
      "help": "Demonstrates a boolean value; no real record is enabled.",
      "required": false,
      "options": []
    }
  ],
  "fixtures": {
    "invalid": {
      "name": "ws-07",
      "hostname": "ws-07",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    },
    "valid": {
      "name": "ws-08",
      "hostname": "ws-08",
      "role": "dev",
      "notes": "Keep these notes while correcting the two fields.",
      "enabled": true
    }
  },
  "validation": "Required values, supported choices, a bounded text length, and explicit local workstation fixture conflicts. Never server-side validation.",
  "announcements": "Errors update on submit, not on input. The summary receives focus; links focus the named field. Review, busy and success update the status once per transition.",
  "tests": [
    "tests/form-model.test.js",
    "tests/browser/validation-recovery.spec.js"
  ],
  "limits": [
    "Local simulation only; no request, account, database or persistence.",
    "Busy requires an explicit simulation-completion event; a submit click is not success.",
    "Automated keyboard/DOM/axe evidence does not claim a manual screen-reader or user-research pass."
  ],
  "version": "0.1.0",
  "theme": {
    "name": "j3w1-theme",
    "version": "0.1.0",
    "profile": "default",
    "sourceDigest": "sha256-8sUU/bKrup5qECRHl5njrhBABq6CnTzjfgoUF3Zm7eY="
  },
  "componentDigests": {
    "admin-form": "sha256-PwtwiAxUFi+NUwb9NzRBX2w3TkTZ5CbDa7QW6rlct1M=",
    "alert": "sha256-2Csls8cNRS1rp1+0Ys+z08tglDn4cxp4mA48pAJu1pw=",
    "button": "sha256-1GNdHUFt6PyAaoHBpBuSbUTXne5XLczun4IEAZNM1Qo=",
    "checkbox": "sha256-T1vSy+Tx6Q9ZCpRKsYfdDbHy4eno9lH/iqACRcKG5yI=",
    "radio-group": "sha256-XRIN1pxpdserFDtjeksasZQgJu2Ac1gEJ/smFlxWspM=",
    "select": "sha256-snZQMgGdyCmHeRYGRsM0GZGw0wxzmfq8AbhMeqtb3sg=",
    "table": "sha256-Lg9g8djDm4AbQ3Ezyxrzs3mc0TPgvcOmr4PQn3zCnAs=",
    "text-field": "sha256-cYWFQ6dredQ+uuxs5ItG4h86XOltSrrYxUAioWauKIg=",
    "textarea": "sha256-UvTFdNJIUdk7uYuvHn0FN902ynYUuAMOte3UYBep0QY="
  }
}
