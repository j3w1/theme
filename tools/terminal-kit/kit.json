{
  "schemaVersion": 1,
  "id": "j3w1-terminal-kit",
  "description": "Local installer for the j3w1 approved default profile in Orca (Windows client), Claude Code and Codex. A consumer of this repository: it reads only the pinned export and never edits canonical sources.",
  "theme": {
    "name": "j3w1-theme",
    "repository": "j3w1/theme",
    "version": "2.0.0",
    "ref": "v2.0.0",
    "revision": "28205bebce9e9c4edab273393ce76347c8b97b3c",
    "profile": "default"
  },
  "exports": {
    "tokens": "exports/tokens.resolved.json",
    "tokensDigest": "sha256-aXiOhIHId7x3GZnKQKM70P5+UxiqBr7kaIoBQln64mE=",
    "digests": "exports/digests.json"
  },
  "urls": {
    "tagRef": "https://api.github.com/repos/{repository}/git/ref/tags/{ref}",
    "raw": "https://raw.githubusercontent.com/{repository}/{revision}/{path}"
  },
  "eligibility": {
    "allowedActions": [
      "use",
      "use-and-report"
    ],
    "forbiddenPrefixes": [
      "color.primitive."
    ],
    "note": "Consume roles within their documented scope, never primitives (agents/consume.md). use-and-report roles are disclosed with their decision ids."
  },
  "integrations": {
    "orca": {
      "roles": "roles/terminal.json",
      "platform": "windows",
      "entry": "windows/Apply-J3w1OrcaTheme.ps1"
    },
    "claude-code": {
      "roles": "roles/claude-code.json",
      "platform": "devbox",
      "entry": "devbox/j3w1-terminal.mjs"
    },
    "codex": {
      "roles": "roles/codex.json",
      "platform": "devbox",
      "entry": "devbox/j3w1-terminal.mjs"
    }
  },
  "specimen": "specimen.json"
}
