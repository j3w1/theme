*{box-sizing:border-box}body{margin:0;font:@READING_SIZE@/@READING_LINE@ @FONT@;text-align:left}.container{width:100%;max-width:min(@MEASURE@ch,@CONTENT_MAX@);margin:auto;padding:@SPACE16@;overflow-wrap:anywhere}.container>:first-child{margin-top:0}p,ul,ol,pre,blockquote,table{margin:0 0 @SPACE16@}li{margin-block:@SPACE4@}ul,ol{padding-left:@SPACE24@}li>p{margin:0}img{max-width:100%;height:auto}h1,h2,h3,h4,h5,h6{margin:@SPACE24@ 0 @SPACE12@;font-weight:@BOLD@;text-wrap:balance}h1{font-size:@H1_SIZE@;line-height:@H1_LINE@}h2{font-size:@H2_SIZE@;line-height:@H2_LINE@}h3,h4,h5,h6{font-size:@H3_SIZE@;line-height:@H3_LINE@}pre{padding:@SPACE12@;border:@BORDER_WIDTH@ solid;overflow-x:auto}code,tt{font-size:@CODE_SIZE@;line-height:@CODE_LINE@;padding:@SPACE2@ @SPACE4@}pre code{display:block;padding:0;font:inherit;white-space:pre;overflow-wrap:normal}strong,th{font-weight:@BOLD@}em{font-style:italic}hr{border:0;border-top:@BORDER_WIDTH@ solid;margin:@SPACE24@ 0}table{width:100%;border-spacing:0;border-collapse:collapse}td,th{padding:@SPACE8@ @SPACE12@;border:@BORDER_WIDTH@ solid;text-align:left;vertical-align:top}blockquote{margin-inline:0;padding:@SPACE8@ @SPACE12@;border-left:@SPACE4@ solid}blockquote>:last-child{margin-bottom:0}input[type=checkbox]{accent-color:@FOCUS@}
@media(forced-colors:none){html,body{background:@CANVAS@;color:@PROSE@}h1,h2,h3,h4,h5,h6{color:@HEADING@}hr,td,th{border-color:@DIVIDER@}th{background:@QUOTE@}pre,code,tt{font-family:@FONT@;color:@PROSE@;background:@CODE@;border-radius:0}pre{font-size:@CODE_SIZE@;line-height:@CODE_LINE@;border-color:@CODE_BORDER@}blockquote{background:@QUOTE@;color:@PROSE@;border-color:@QUOTE_BORDER@}a{color:@LINK@;text-decoration:underline;text-decoration-color:@LINK_UNDERLINE@}a:hover{color:@LINK_HOVER@}a:focus-visible{outline:@BORDER_WIDTH@ dashed @FOCUS@;outline-offset:-2px}::selection{background:@SELECTION@;color:@SELECTION_TEXT@}html{scrollbar-color:@SCROLLBAR@ @CANVAS@}}
