// Owned startup and recovery boundary for the pinned Settings rendering adapter.
// No window text, document data or pixels participate in admission.
#include <bcrypt.h>
namespace j3w1Settings {
static bool DigestFile(const std::wstring& path,const char* expected) {
    HANDLE file=CreateFileW(path.c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,
        OPEN_EXISTING,FILE_FLAG_OPEN_REPARSE_POINT,nullptr);
    if(file==INVALID_HANDLE_VALUE)return false;
    BY_HANDLE_FILE_INFORMATION info{};BCRYPT_ALG_HANDLE algorithm=nullptr;
    BCRYPT_HASH_HANDLE hash=nullptr;bool ok=false;
    if(GetFileInformationByHandle(file,&info)&&!(info.dwFileAttributes&FILE_ATTRIBUTE_REPARSE_POINT)
        &&BCryptOpenAlgorithmProvider(&algorithm,BCRYPT_SHA256_ALGORITHM,nullptr,0)>=0
        &&BCryptCreateHash(algorithm,&hash,nullptr,0,nullptr,0,0)>=0) {
        BYTE buffer[65536],digest[32]{};DWORD count=0;ok=true;
        for(;;) {
            if(!ReadFile(file,buffer,sizeof(buffer),&count,nullptr)){ok=false;break;}
            if(!count)break;
            if(BCryptHashData(hash,buffer,count,0)<0){ok=false;break;}
        }
        ok=ok&&BCryptFinishHash(hash,digest,sizeof(digest),0)>=0;
        const char hex[]="0123456789abcdef";char actual[65]{};
        for(size_t i=0;i<32;i++){actual[i*2]=hex[digest[i]>>4];actual[i*2+1]=hex[digest[i]&15];}
        ok=ok&&strcmp(actual,expected)==0;
    }
    if(hash)BCryptDestroyHash(hash);
    if(algorithm)BCryptCloseAlgorithmProvider(algorithm,0);
    CloseHandle(file);return ok;
}
static bool Admit() {
    wchar_t exe[32768]{},system[32768]{},modulePath[32768]{};
    const DWORD exeLength=GetModuleFileNameW(nullptr,exe,32768);
    const DWORD systemLength=GetSystemWindowsDirectoryW(system,32768);
    const HMODULE module=GetModuleHandleW(L"Windows.UI.Xaml.dll");
    const DWORD moduleLength=module?GetModuleFileNameW(module,modulePath,32768):0;
    HIGHCONTRASTW contrast{sizeof(contrast)};
    return exeLength&&exeLength<32768&&systemLength&&systemLength<32768
        &&moduleLength&&moduleLength<32768
        &&_wcsicmp(exe,(std::wstring(system)+L"\\ImmersiveControlPanel\\SystemSettings.exe").c_str())==0
        &&DigestFile(exe,"@EXECUTABLE_SHA256@")
        &&DigestFile(modulePath,"@XAML_SHA256@")
        &&SystemParametersInfoW(SPI_GETHIGHCONTRAST,sizeof(contrast),&contrast,0)
        &&!(contrast.dwFlags&HCF_HIGHCONTRASTON);
}
}

HWND GetCoreWnd() {
    struct Candidates { HWND window=nullptr;unsigned count=0;DWORD thread=0; };
    Candidates candidates{nullptr,0,g_targetThreadId.load()};
    EnumWindows([](HWND top,LPARAM parameter)->BOOL {
        auto& candidates=*reinterpret_cast<Candidates*>(parameter);
        const auto admit=[&](HWND window) {
            DWORD process=0;const DWORD thread=GetWindowThreadProcessId(window,&process);
            if(!thread||process!=GetCurrentProcessId()
                ||(candidates.thread&&thread!=candidates.thread))return;
            if(window!=candidates.window){candidates.window=window;++candidates.count;}
        };
        wchar_t className[64]{};
        if(!GetClassNameW(top,className,64))return TRUE;
        if(_wcsicmp(className,L"Windows.UI.Core.CoreWindow")==0)admit(top);
        else if(_wcsicmp(className,L"ApplicationFrameWindow")==0) {
            HWND child=nullptr;
            while((child=FindWindowExW(top,child,L"Windows.UI.Core.CoreWindow",nullptr)))admit(child);
        }
        return TRUE;
    },reinterpret_cast<LPARAM>(&candidates));
    // An ambiguous or missing owner cannot initialize or restore another root.
    return candidates.count==1?candidates.window:nullptr;
}
