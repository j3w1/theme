{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#000000",
    "--editor-surface": "#000000",
    "--foreground": "#e99499",
    "--card": "#0e1014",
    "--card-foreground": "#e99499",
    "--popover": "#15181e",
    "--popover-foreground": "#e99499",
    "--primary": "#f73f35",
    "--primary-foreground": "#000000",
    "--secondary": "#15181e",
    "--secondary-foreground": "#e99499",
    "--muted": "#0e1014",
    "--muted-foreground": "#d4868b",
    "--accent": "#531310",
    "--accent-foreground": "#f4eeee",
    "--border": "#303640",
    "--input": "#747e8e",
    "--ring": "#e53935",
    "--chart-1": "#ffa2a7",
    "--chart-2": "#f73f35",
    "--chart-3": "#bd787d",
    "--chart-4": "#a3676b",
    "--chart-5": "#82b4ff",
    "--sidebar": "#000000",
    "--sidebar-foreground": "#e99499",
    "--sidebar-primary": "#f73f35",
    "--sidebar-primary-foreground": "#000000",
    "--sidebar-accent": "#531310",
    "--sidebar-accent-foreground": "#f4eeee",
    "--sidebar-border": "#303640",
    "--sidebar-ring": "#e53935",
    "--worktree-sidebar": "#000000",
    "--worktree-sidebar-foreground": "#e99499",
    "--worktree-sidebar-accent": "#531310",
    "--worktree-sidebar-accent-foreground": "#f4eeee",
    "--worktree-sidebar-border": "#303640",
    "--worktree-sidebar-ring": "#e53935"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": "comment",
      "settings": {
        "foreground": "#bd787d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#c7a0e8"
      }
    },
    {
      "name": "operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#e99499"
      }
    },
    {
      "name": "string",
      "scope": "string",
      "settings": {
        "foreground": "#82d9a0"
      }
    },
    {
      "name": "number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "constant",
      "scope": "constant.language",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "function",
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#82b4ff"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#78d4d4"
      }
    },
    {
      "name": "variable",
      "scope": "variable",
      "settings": {
        "foreground": "#e99499"
      }
    },
    {
      "name": "property",
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#78d4d4"
      }
    },
    {
      "name": "attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "tag",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "escape",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#d4868b"
      }
    },
    {
      "name": "heading",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#f1f5f9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "link",
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#f73f35",
        "fontStyle": "underline"
      }
    },
    {
      "name": "inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#82d9a0"
      }
    },
    {
      "name": "deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#e53935"
      }
    },
    {
      "name": "changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#f73f35",
        "fontStyle": "underline"
      }
    }
  ]
}
