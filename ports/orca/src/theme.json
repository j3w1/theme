    },
    {
      "name": "escape",
      "scope": "constant.character.escape"
    },
    {
      "name": "punctuation",
      "scope": "punctuation"
    },
    {
      "name": "heading",
      "scope": "markup.heading",
      "fontStyle": "bold"
    },
    {
      "name": "link",
      "scope": "markup.underline.link",
      "fontStyle": "underline"
    },
    {
      "name": "inserted",
      "scope": "markup.inserted"
    },
    {
      "name": "deleted",
      "scope": "markup.deleted"
    },
    {
      "name": "changed",
      "scope": "markup.changed"
    },
    {
      "name": "invalid",
      "scope": "invalid",
      "fontStyle": "underline"
    }
