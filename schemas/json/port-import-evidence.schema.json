{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "method": {
      "type": "string",
      "const": "real-import"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not run"
      ]
    },
    "subjectDigest": {
      "type": "string",
      "pattern": "^sha256-"
    },
    "applicationVersion": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows",
        "linux",
        "macos"
      ]
    },
    "os": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not run"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "result",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "method",
    "result",
    "subjectDigest",
    "applicationVersion",
    "platform",
    "os",
    "protocol",
    "checks",
    "limits"
  ],
  "additionalProperties": false
}
