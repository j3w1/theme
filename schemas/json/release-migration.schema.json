{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "from": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "to": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "from",
    "to",
    "roles"
  ],
  "additionalProperties": false
}
