{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "user-screenshot",
        "illustrative",
        "live-capture"
      ]
    },
    "application": {
      "type": "string",
      "minLength": 1
    },
    "applicationVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "os": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "capturedOn": {
      "type": [
        "string",
        "null"
      ]
    },
    "receivedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1
    },
    "notProofOf": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "file",
    "kind",
    "application",
    "applicationVersion",
    "os",
    "profile",
    "sourceRevision",
    "capturedOn",
    "receivedOn",
    "width",
    "height",
    "redactions",
    "caption",
    "notProofOf"
  ],
  "additionalProperties": false
}
