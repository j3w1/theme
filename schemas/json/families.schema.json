{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "order": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "title",
      "order",
      "description"
    ],
    "additionalProperties": false
  }
}
