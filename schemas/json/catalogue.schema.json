{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "historical",
              "screenshot",
              "reference-implementation"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "repository",
              "path"
            ],
            "additionalProperties": false
          },
          "path": {
            "type": "string",
            "pattern": "^references\\/"
          },
          "verificationStatus": {
            "type": "string",
            "const": "reference-only"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "verificationStatus",
          "notes",
          "license"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "entries"
  ],
  "additionalProperties": false
}
