{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "integration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "type": "string",
          "enum": [
            "css-vars",
            "vuetify",
            "tailwind",
            "jetbrains-icls",
            "gtk-css",
            "terminal-16",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "kind"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "mode": {
      "type": "string",
      "enum": [
        "standard",
        "minimal"
      ]
    }
  },
  "required": [
    "revision",
    "resolvedAt",
    "profile",
    "components",
    "integration",
    "task",
    "mode"
  ],
  "additionalProperties": false
}
