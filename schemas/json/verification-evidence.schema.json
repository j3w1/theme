{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256-"
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256-"
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "timedout",
            "interrupted"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "startedAt",
        "completedAt",
        "result",
        "reference"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e-[a-z0-9]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "automated",
              "manual"
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "category": {
                "type": "string",
                "enum": [
                  "rendering",
                  "appearance",
                  "keyboard",
                  "structure",
                  "axe",
                  "reflow",
                  "motion",
                  "enhancements",
                  "print",
                  "screen-reader"
                ]
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "component",
              "category",
              "states",
              "variants",
              "note"
            ],
            "additionalProperties": false
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not run",
              "not applicable"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^tests\\/[a-zA-Z0-9/._-]+$"
                  },
                  "title": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "file",
                  "title",
                  "line"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "environment": {
            "type": "object",
            "properties": {
              "browser": {
                "type": "string"
              },
              "browserVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "os": {
                "type": "string"
              },
              "viewport": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "project": {
                "type": "string"
              },
              "profile": {
                "type": "string"
              },
              "density": {
                "type": "string"
              },
              "javaScript": {
                "type": "boolean"
              }
            },
            "required": [
              "browser",
              "browserVersion",
              "os",
              "viewport",
              "project",
              "profile",
              "density",
              "javaScript"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "scope",
          "result",
          "reason",
          "reference",
          "test",
          "environment"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "sourceDigest",
    "artifactDigest",
    "revision",
    "run",
    "records"
  ],
  "additionalProperties": false
}
